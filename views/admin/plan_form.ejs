<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= plan ? '编辑套餐' : '新建套餐' %> - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-container-md mi-page">
    <h1 class="mi-page-title"><%= plan ? '编辑套餐' : '新建套餐' %></h1>

    <form method="POST" class="mi-form-card">
      <div class="mi-input-group">
        <label class="mi-label">套餐名称</label>
        <input type="text" name="name" value="<%= plan ? plan.name : '' %>" required class="mi-input">
      </div>
      <div class="mi-input-group">
        <label class="mi-label">描述</label>
        <textarea name="description" rows="2" class="mi-textarea"><%= plan ? plan.description : '' %></textarea>
      </div>
      <div class="mi-grid mi-grid-2">
        <div class="mi-input-group">
          <label class="mi-label">流量（GB，0 = 无限）</label>
          <input type="number" name="data_limit" value="<%= plan ? plan.data_limit : 0 %>" min="0" class="mi-input">
        </div>
        <div class="mi-input-group">
          <label class="mi-label">有效天数</label>
          <input type="number" name="duration_days" value="<%= plan ? plan.duration_days : 30 %>" min="1" class="mi-input">
        </div>
      </div>
      <div class="mi-grid mi-grid-2">
        <div class="mi-input-group">
          <label class="mi-label">价格</label>
          <input type="number" name="price" value="<%= plan ? plan.price : 0 %>" min="0" step="0.01" class="mi-input">
        </div>
        <div class="mi-input-group">
          <label class="mi-label">最大 IP 数</label>
          <input type="number" name="max_ips" value="<%= plan ? plan.max_ips : 3 %>" min="1" class="mi-input">
        </div>
      </div>
      <div class="mi-input-group">
        <label class="mi-label">绑定 Inbound ID</label>
        <select name="inbound_id" class="mi-select">
          <option value="">不绑定</option>
          <% inbounds.forEach(ib => { %>
          <option value="<%= ib.id %>" <%= plan && plan.inbound_id == ib.id ? 'selected' : '' %>>
            #<%= ib.id %> - <%= ib.remark %> (<%= ib.protocol %>:<%= ib.port %>)
          </option>
          <% }) %>
        </select>
      </div>
      <% if (plan) { %>
      <div class="mi-checkbox-group mi-mt-2">
        <input type="checkbox" name="enabled" id="enabled" class="mi-checkbox" <%= plan.enabled ? 'checked' : '' %>>
        <label for="enabled" class="mi-checkbox-label">启用</label>
      </div>
      <% } %>
      <div class="mi-form-footer mi-mt-4">
        <button type="submit" class="mi-btn mi-btn-primary">保存</button>
        <a href="/admin/plans" class="mi-btn mi-btn-secondary">取消</a>
      </div>
    </form>
  </div>
</body>
</html>
