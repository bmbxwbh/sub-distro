<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= plan ? '编辑套餐' : '新建套餐' %> - sub-distro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6"><%= plan ? '编辑套餐' : '新建套餐' %></h1>

    <form method="POST" class="bg-white p-6 rounded-lg shadow space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">套餐名称</label>
        <input type="text" name="name" value="<%= plan ? plan.name : '' %>" required
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">描述</label>
        <textarea name="description" rows="2"
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= plan ? plan.description : '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">流量 (GB, 0=无限)</label>
          <input type="number" name="data_limit" value="<%= plan ? plan.data_limit : 0 %>" min="0"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">有效天数</label>
          <input type="number" name="duration_days" value="<%= plan ? plan.duration_days : 30 %>" min="1"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">价格</label>
          <input type="number" name="price" value="<%= plan ? plan.price : 0 %>" min="0" step="0.01"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">最大 IP 数</label>
          <input type="number" name="max_ips" value="<%= plan ? plan.max_ips : 3 %>" min="1"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">绑定 Inbound ID</label>
        <select name="inbound_id"
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="">不绑定</option>
          <% inbounds.forEach(ib => { %>
          <option value="<%= ib.id %>" <%= plan && plan.inbound_id == ib.id ? 'selected' : '' %>>
            #<%= ib.id %> - <%= ib.remark %> (<%= ib.protocol %>:<%= ib.port %>)
          </option>
          <% }) %>
        </select>
      </div>
      <% if (plan) { %>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="enabled" id="enabled" <%= plan.enabled ? 'checked' : '' %>>
        <label for="enabled" class="text-sm text-gray-700">启用</label>
      </div>
      <% } %>
      <div class="flex gap-3">
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">保存</button>
        <a href="/admin/plans" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">取消</a>
      </div>
    </form>
  </div>
</body>
</html>
