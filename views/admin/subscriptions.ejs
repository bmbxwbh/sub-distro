<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订阅管理 - sub-distro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">订阅管理</h1>

    <div class="bg-white rounded-lg shadow overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">ID</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">用户</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">套餐</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">Email</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">流量</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">到期时间</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">状态</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% rows.forEach(s => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= s.id %></td>
            <td class="px-4 py-3"><%= s.username %></td>
            <td class="px-4 py-3"><%= s.plan_name || '-' %></td>
            <td class="px-4 py-3 text-sm font-mono"><%= s.email %></td>
            <td class="px-4 py-3">
              <% if (s.data_limit) { %>
                <%= s.data_used %> / <%= s.data_limit %> GB
              <% } else { %>
                无限
              <% } %>
            </td>
            <td class="px-4 py-3 text-sm"><%= s.expires_at %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 text-xs rounded-full
                <%= s.enabled ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= s.enabled ? '有效' : '禁用' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
    <div class="flex justify-center gap-2 mt-6">
      <% for (let i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>"
        class="px-3 py-1 rounded <%= i === page ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
        <%= i %>
      </a>
      <% } %>
    </div>
    <% } %>
  </div>
</body>
</html>
