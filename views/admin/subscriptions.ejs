<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订阅管理 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">订阅管理</h1>

    <div class="mi-table-wrapper">
      <table class="mi-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>用户</th>
            <th>套餐</th>
            <th>Email</th>
            <th>流量</th>
            <th>到期时间</th>
            <th>状态</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(s => { %>
          <tr>
            <td><%= s.id %></td>
            <td><%= s.username %></td>
            <td><%= s.plan_name || '-' %></td>
            <td class="mono"><%= s.email %></td>
            <td>
              <% if (s.data_limit) { %>
                <%= s.data_used %> / <%= s.data_limit %> GB
              <% } else { %>
                无限
              <% } %>
            </td>
            <td class="mi-text-sm"><%= s.expires_at %></td>
            <td>
              <span class="mi-badge <%= s.enabled ? 'mi-badge-success' : 'mi-badge-error' %>">
                <%= s.enabled ? '有效' : '禁用' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
    <div class="mi-pagination">
      <% for (let i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>" class="mi-page-btn <%= i === page ? 'mi-page-btn-active' : '' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
  </div>
</body>
</html>
