<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3x-ui 配置 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-container-md mi-page">
    <h1 class="mi-page-title">3x-ui 面板配置</h1>

    <form method="POST" class="mi-form-card">
      <div class="mi-input-group">
        <label class="mi-label">面板地址</label>
        <input type="url" name="base_url" value="<%= config ? config.base_url : '' %>"
          placeholder="http://your-panel:2053" required class="mi-input">
      </div>
      <div class="mi-input-group">
        <label class="mi-label">用户名</label>
        <input type="text" name="username" value="<%= config ? config.username : '' %>" required class="mi-input">
      </div>
      <div class="mi-input-group">
        <label class="mi-label">密码</label>
        <input type="password" name="password" value="<%= config ? config.password : '' %>" required class="mi-input">
      </div>
      <div class="mi-form-footer">
        <button type="submit" class="mi-btn mi-btn-primary">保存</button>
        <button type="button" onclick="testConnection()" class="mi-btn mi-btn-ghost">测试连接</button>
      </div>
    </form>

    <div id="testResult" class="mi-mt-4 mi-hidden">
      <div class="mi-flash-inner"></div>
    </div>
  </div>

  <script>
    async function testConnection() {
      const res = await fetch('/admin/xui/test', { method: 'POST' });
      const data = await res.json();
      const el = document.getElementById('testResult');
      el.classList.remove('mi-hidden');
      const inner = el.querySelector('div');
      inner.className = 'mi-flash-inner ' + (data.success ? 'mi-flash-success' : 'mi-flash-error');
      inner.textContent = data.message;
    }
  </script>
</body>
</html>
