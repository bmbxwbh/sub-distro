<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3x-ui 配置 - sub-distro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">3x-ui 面板配置</h1>

    <form method="POST" class="bg-white p-6 rounded-lg shadow space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">面板地址</label>
        <input type="url" name="base_url" value="<%= config ? config.base_url : '' %>"
          placeholder="http://your-panel:2053" required
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">用户名</label>
        <input type="text" name="username" value="<%= config ? config.username : '' %>" required
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">密码</label>
        <input type="password" name="password" value="<%= config ? config.password : '' %>" required
          class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div class="flex gap-3">
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">保存</button>
        <button type="button" onclick="testConnection()" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">测试连接</button>
      </div>
    </form>

    <div id="testResult" class="mt-4 hidden">
      <div class="p-3 rounded-lg text-sm"></div>
    </div>
  </div>

  <script>
    async function testConnection() {
      const res = await fetch('/admin/xui/test', { method: 'POST' });
      const data = await res.json();
      const el = document.getElementById('testResult');
      el.classList.remove('hidden');
      el.querySelector('div').className = `p-3 rounded-lg text-sm ${data.success ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`;
      el.querySelector('div').textContent = data.message;
    }
  </script>
</body>
</html>
