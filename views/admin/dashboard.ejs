<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">管理后台</h1>

    <!-- Stats -->
    <div class="mi-stats">
      <div class="mi-stat-card">
        <div class="mi-stat-label">用户总数</div>
        <div class="mi-stat-value mi-stat-primary"><%= stats.totalUsers %></div>
      </div>
      <div class="mi-stat-card">
        <div class="mi-stat-label">订阅总数</div>
        <div class="mi-stat-value mi-stat-success"><%= stats.totalSubs %></div>
      </div>
      <div class="mi-stat-card">
        <div class="mi-stat-label">套餐数量</div>
        <div class="mi-stat-value mi-stat-purple"><%= stats.totalPlans %></div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mi-card">
      <div class="mi-card-body-lg">
        <h2 class="text-headline mi-mb-4">快捷操作</h2>
        <div class="mi-actions">
          <a href="/admin/users" class="mi-action-chip mi-action-blue">👥 用户管理</a>
          <a href="/admin/plans" class="mi-action-chip mi-action-green">📦 套餐管理</a>
          <a href="/admin/subscriptions" class="mi-action-chip mi-action-purple">📋 订阅管理</a>
          <a href="/admin/subscriptions/create" class="mi-action-chip mi-action-purple">➕ 代开订阅</a>
          <a href="/admin/orders" class="mi-action-chip mi-action-orange">🧾 订单管理</a>
          <a href="/admin/coupons" class="mi-action-chip mi-action-orange">🏷️ 优惠码</a>
          <a href="/admin/nodes" class="mi-action-chip mi-action-blue">📡 节点监控</a>
          <a href="/admin/xui" class="mi-action-chip mi-action-orange">⚙️ 3x-ui 配置</a>
        </div>
      </div>
    </div>

    <% if (stats.serverStatus) { %>
    <div class="mi-card mi-mt-6">
      <div class="mi-card-body-lg">
        <h2 class="text-headline mi-mb-4">服务器状态</h2>
        <div class="mi-info-grid">
          <div class="mi-info-item">
            <span class="mi-info-label">CPU</span>
            <span class="mi-info-value"><%= stats.serverStatus.cpu %>%</span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">内存</span>
            <span class="mi-info-value"><%= stats.serverStatus.mem ? (stats.serverStatus.mem / 1024 / 1024).toFixed(0) + 'MB' : 'N/A' %></span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">运行时间</span>
            <span class="mi-info-value"><%= stats.serverStatus.uptime || 'N/A' %></span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">Xray</span>
            <span class="mi-info-value"><%= stats.serverStatus.xray_state || 'N/A' %></span>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</body>
</html>
