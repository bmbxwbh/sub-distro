<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>套餐管理 - sub-distro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">套餐管理</h1>
      <a href="/admin/plans/new" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">新建套餐</a>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">名称</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">流量</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">天数</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">价格</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">状态</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% plans.forEach(plan => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= plan.name %></td>
            <td class="px-4 py-3"><%= plan.data_limit ? plan.data_limit + ' GB' : '无限' %></td>
            <td class="px-4 py-3"><%= plan.duration_days %> 天</td>
            <td class="px-4 py-3">¥<%= plan.price %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 text-xs rounded-full <%= plan.enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500' %>">
                <%= plan.enabled ? '启用' : '禁用' %>
              </span>
            </td>
            <td class="px-4 py-3">
              <a href="/admin/plans/<%= plan.id %>/edit" class="text-blue-600 hover:underline text-sm mr-2">编辑</a>
              <form method="POST" action="/admin/plans/<%= plan.id %>/delete" class="inline"
                onsubmit="return confirm('确定删除?')">
                <button type="submit" class="text-red-600 hover:underline text-sm">删除</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
