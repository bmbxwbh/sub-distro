<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>套餐管理 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <div class="mi-section-header">
      <h1 class="mi-page-title" style="margin-bottom:0">套餐管理</h1>
      <a href="/admin/plans/new" class="mi-btn mi-btn-primary mi-btn-sm">新建套餐</a>
    </div>

    <div class="mi-table-wrapper">
      <table class="mi-table">
        <thead>
          <tr>
            <th>名称</th>
            <th>流量</th>
            <th>天数</th>
            <th>价格</th>
            <th>状态</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% plans.forEach(plan => { %>
          <tr>
            <td data-label="名称"><strong><%= plan.name %></strong></td>
            <td data-label="流量"><%= plan.data_limit ? plan.data_limit + ' GB' : '无限' %></td>
            <td data-label="天数"><%= plan.duration_days %> 天</td>
            <td data-label="价格">¥<%= plan.price %></td>
            <td data-label="状态">
              <span class="mi-badge <%= plan.enabled ? 'mi-badge-success' : 'mi-badge-neutral' %>">
                <%= plan.enabled ? '启用' : '禁用' %>
              </span>
            </td>
            <td data-label="操作">
              <a href="/admin/plans/<%= plan.id %>/edit" class="mi-inline-action">编辑</a>
              <form method="POST" action="/admin/plans/<%= plan.id %>/delete" class="mi-inline"
                onsubmit="return confirm('确定删除?')">
                <button type="submit" class="mi-inline-action mi-inline-action-danger">删除</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
