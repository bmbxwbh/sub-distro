<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>用户管理 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">用户管理</h1>

    <div class="mi-table-wrapper">
      <table class="mi-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>用户名</th>
            <th>邮箱</th>
            <th>角色</th>
            <th>状态</th>
            <th>注册时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(u => { %>
          <tr>
            <td data-label="ID"><%= u.id %></td>
            <td data-label="用户名"><strong><%= u.username %></strong></td>
            <td data-label="邮箱" class="mi-text-muted"><%= u.email || '-' %></td>
            <td data-label="角色">
              <span class="mi-badge <%= u.role === 'admin' ? 'mi-badge-admin' : 'mi-badge-info' %>">
                <%= u.role %>
              </span>
            </td>
            <td data-label="状态">
              <span class="mi-badge <%= u.status === 'active' ? 'mi-badge-success' : 'mi-badge-neutral' %>">
                <%= u.status %>
              </span>
            </td>
            <td data-label="注册时间" class="mi-text-sm mi-text-muted"><%= u.created_at %></td>
            <td data-label="操作">
              <% if (u.role !== 'admin') { %>
              <form method="POST" action="/admin/users/<%= u.id %>/ban" class="mi-inline">
                <button type="submit" class="mi-inline-action">封禁</button>
              </form>
              <form method="POST" action="/admin/users/<%= u.id %>/delete" class="mi-inline"
                onsubmit="return confirm('确定删除?')">
                <button type="submit" class="mi-inline-action mi-inline-action-danger">删除</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
    <div class="mi-pagination">
      <% for (let i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>" class="mi-page-btn <%= i === page ? 'mi-page-btn-active' : '' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
  </div>
</body>
</html>
