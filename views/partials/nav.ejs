<nav class="mi-nav">
  <div class="mi-nav-inner">
    <a href="/" class="mi-nav-brand">sub-distro</a>
    <button class="mi-nav-toggle" onclick="toggleNav()" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>
    <div class="mi-nav-links" id="navLinks">
      <% if (user) { %>
        <a href="/user" class="mi-nav-link">用户中心</a>
        <a href="/user/orders" class="mi-nav-link">订单</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="mi-nav-link">管理后台</a>
        <% } %>
        <span class="mi-nav-user"><%= user.username %></span>
        <a href="/auth/logout" class="mi-nav-logout">退出</a>
      <% } else { %>
        <a href="/auth/login" class="mi-nav-link">登录</a>
        <a href="/auth/register" class="mi-nav-link mi-nav-link-primary">注册</a>
      <% } %>
    </div>
  </div>
</nav>

<% if (flash) { %>
  <div class="mi-flash">
    <div class="mi-flash-inner <%= flash.type === 'success' ? 'mi-flash-success' : 'mi-flash-error' %>">
      <%= flash.message %>
    </div>
  </div>
<% } %>

<script>
  function toggleNav() {
    var btn = document.querySelector('.mi-nav-toggle');
    var links = document.getElementById('navLinks');
    btn.classList.toggle('active');
    links.classList.toggle('open');
  }
  // 点击链接后自动关闭菜单
  document.querySelectorAll('.mi-nav-link').forEach(function(link) {
    link.addEventListener('click', function() {
      document.querySelector('.mi-nav-toggle').classList.remove('active');
      document.getElementById('navLinks').classList.remove('open');
    });
  });
</script>
