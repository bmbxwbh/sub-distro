<nav class="bg-white shadow">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-blue-600">sub-distro</a>
    <div class="flex gap-4 items-center">
      <% if (user) { %>
        <a href="/user" class="text-gray-600 hover:text-blue-600">用户中心</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="text-gray-600 hover:text-blue-600">管理后台</a>
        <% } %>
        <span class="text-sm text-gray-400"><%= user.username %></span>
        <a href="/auth/logout" class="text-red-500 hover:text-red-700 text-sm">退出</a>
      <% } else { %>
        <a href="/auth/login" class="text-gray-600 hover:text-blue-600">登录</a>
        <a href="/auth/register" class="bg-blue-600 text-white px-4 py-1.5 rounded hover:bg-blue-700 text-sm">注册</a>
      <% } %>
    </div>
  </div>
</nav>

<% if (flash) { %>
  <div class="max-w-6xl mx-auto px-4 mt-4">
    <div class="p-3 rounded-lg text-sm
      <%= flash.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
      <%= flash.message %>
    </div>
  </div>
<% } %>
