<nav class="mi-nav">
  <div class="mi-nav-inner">
    <a href="/" class="mi-nav-brand">sub-distro</a>
    <div class="mi-nav-links">
      <% if (user) { %>
        <a href="/user" class="mi-nav-link">用户中心</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="mi-nav-link">管理后台</a>
        <% } %>
        <span class="mi-nav-user"><%= user.username %></span>
        <a href="/auth/logout" class="mi-nav-logout">退出</a>
      <% } else { %>
        <a href="/auth/login" class="mi-nav-link">登录</a>
        <a href="/auth/register" class="mi-nav-link mi-nav-link-primary">注册</a>
      <% } %>
    </div>
  </div>
</nav>

<% if (flash) { %>
  <div class="mi-flash">
    <div class="mi-flash-inner <%= flash.type === 'success' ? 'mi-flash-success' : 'mi-flash-error' %>">
      <%= flash.message %>
    </div>
  </div>
<% } %>
