<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订阅详情 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-container-md mi-page">
    <h1 class="mi-page-title">订阅详情</h1>

    <!-- Info Card -->
    <div class="mi-card mi-mb-4">
      <div class="mi-card-body-lg">
        <div class="mi-flex mi-justify-between mi-items-center mi-mb-4">
          <h2 class="text-title4"><%= sub.plan_name || '订阅' %></h2>
          <span class="mi-badge <%= sub.enabled ? 'mi-badge-success' : 'mi-badge-error' %>">
            <%= sub.enabled ? '有效' : '已禁用' %>
          </span>
        </div>
        <div class="mi-info-grid">
          <div class="mi-info-item">
            <span class="mi-info-label">Email</span>
            <span class="mi-info-value mono"><%= sub.email %></span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">UUID</span>
            <span class="mi-info-value mono"><%= sub.uuid %></span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">流量</span>
            <span class="mi-info-value">
              <% if (sub.data_limit) { %>
                <%= sub.data_used %> / <%= sub.data_limit %> GB
                <div class="mi-progress">
                  <div class="mi-progress-bar" style="width: <%= Math.min(100, (sub.data_used / sub.data_limit * 100)) %>%"></div>
                </div>
              <% } else { %>
                无限
              <% } %>
            </span>
          </div>
          <div class="mi-info-item">
            <span class="mi-info-label">到期</span>
            <span class="mi-info-value"><%= sub.expires_at %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Subscription Link -->
    <div class="mi-card mi-mb-4">
      <div class="mi-card-body-lg">
        <h3 class="text-headline mi-mb-3">订阅链接</h3>
        <div class="mi-copy-group">
          <input type="text" value="<%= subUrl %>" readonly id="subUrl" class="mi-copy-input">
          <button onclick="copy()" class="mi-btn mi-btn-primary mi-btn-sm">复制</button>
        </div>
        <p class="mi-form-hint">在客户端中添加此订阅链接即可自动获取节点配置</p>
      </div>
    </div>

    <!-- Format Links -->
    <div class="mi-card mi-mb-4">
      <div class="mi-card-body-lg">
        <h3 class="text-headline mi-mb-3">多格式订阅</h3>
        <div class="mi-link-list">
          <a href="/sub/<%= sub.token %>/raw" target="_blank" class="mi-link-item">
            <span class="mi-link-icon">📄</span> Base64（V2RayN / Shadowrocket）
          </a>
          <a href="/sub/<%= sub.token %>/clash" target="_blank" class="mi-link-item">
            <span class="mi-link-icon">⚔️</span> Clash YAML
          </a>
          <a href="/sub/<%= sub.token %>/singbox" target="_blank" class="mi-link-item">
            <span class="mi-link-icon">📦</span> Sing-box JSON
          </a>
        </div>
      </div>
    </div>

    <!-- QR Code -->
    <div class="mi-card mi-mb-4">
      <div class="mi-card-body-lg mi-qr">
        <h3 class="text-headline mi-mb-3">扫码导入</h3>
        <img src="/sub/<%= sub.token %>/qr" alt="QR Code">
        <p class="mi-form-hint">使用支持扫码的客户端扫描此二维码</p>
      </div>
    </div>

    <!-- Nodes -->
    <% if (result && result.nodes && result.nodes.length > 0) { %>
    <div class="mi-card mi-mb-4">
      <div class="mi-card-body-lg">
        <h3 class="text-headline mi-mb-3">可用节点（<%= result.nodes.length %>）</h3>
        <div class="mi-flex mi-flex-col mi-gap-2">
          <% result.nodes.forEach(node => { %>
          <div class="mi-node">
            <span class="mi-node-tag"><%= node.protocol %></span>
            <span class="mi-node-name"><%= node.name %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>

    <a href="/user" class="mi-btn mi-btn-text mi-mt-4">← 返回我的订阅</a>
  </div>

  <script>
    function copy() {
      const input = document.getElementById('subUrl');
      navigator.clipboard.writeText(input.value);
      input.select();
    }
  </script>
</body>
</html>
