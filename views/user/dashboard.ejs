<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>用户中心 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">我的订阅</h1>

    <% if (subs.length === 0) { %>
    <div class="mi-card">
      <div class="mi-empty">
        <div class="mi-empty-icon">📦</div>
        <p class="mi-empty-text">你还没有订阅</p>
        <a href="/user/plans" class="mi-btn mi-btn-primary">浏览套餐</a>
      </div>
    </div>
    <% } else { %>
    <div class="mi-grid mi-grid-2">
      <% subs.forEach(s => { %>
      <a href="/user/sub/<%= s.token %>" class="mi-card mi-card-interactive" style="text-decoration:none; color:inherit;">
        <div class="mi-card-body">
          <div class="mi-flex mi-justify-between mi-items-center mi-mb-2">
            <h3 class="text-headline"><%= s.plan_name || '套餐' %></h3>
            <span class="mi-badge <%= s.enabled ? 'mi-badge-success' : 'mi-badge-error' %>">
              <%= s.enabled ? '有效' : '已禁用' %>
            </span>
          </div>
          <div class="mi-text-sm mi-text-muted mi-mb-4">Email: <%= s.email %></div>
          <div class="mi-info-grid">
            <div class="mi-info-item">
              <span class="mi-info-label">流量</span>
              <span class="mi-info-value">
                <% if (s.data_limit) { %><%= s.data_used %> / <%= s.data_limit %> GB<% } else { %>无限<% } %>
              </span>
            </div>
            <div class="mi-info-item">
              <span class="mi-info-label">到期</span>
              <span class="mi-info-value"><%= s.expires_at %></span>
            </div>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
    <% } %>

    <div class="mi-flex mi-gap-3 mi-mt-6">
      <a href="/user/plans" class="mi-btn mi-btn-primary">购买新套餐</a>
      <a href="/user/orders" class="mi-btn mi-btn-ghost">我的订单</a>
    </div>
  </div>
</body>
</html>
