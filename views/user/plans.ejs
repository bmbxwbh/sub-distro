<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>套餐列表 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">选择套餐</h1>

    <% if (plans.length === 0) { %>
    <div class="mi-card">
      <div class="mi-empty">
        <div class="mi-empty-icon">📋</div>
        <p class="mi-empty-text">暂无可用套餐</p>
      </div>
    </div>
    <% } else { %>
    <div class="mi-grid mi-grid-2">
      <% plans.forEach(plan => { %>
      <div class="mi-plan-card">
        <div class="mi-plan-header">
          <h3 class="mi-plan-name"><%= plan.name %></h3>
          <p class="mi-plan-desc"><%= plan.description || '' %></p>
        </div>
        <div class="mi-plan-details">
          <div class="mi-plan-row">
            <span class="mi-plan-row-label">流量</span>
            <span class="mi-plan-row-value"><%= plan.data_limit ? plan.data_limit + ' GB' : '无限' %></span>
          </div>
          <div class="mi-plan-row">
            <span class="mi-plan-row-label">有效期</span>
            <span class="mi-plan-row-value"><%= plan.duration_days %> 天</span>
          </div>
          <div class="mi-plan-row">
            <span class="mi-plan-row-label">设备数</span>
            <span class="mi-plan-row-value"><%= plan.max_ips %></span>
          </div>
        </div>
        <div class="mi-plan-footer">
          <span class="mi-plan-price">¥<%= plan.price %></span>
          <form method="POST" action="/user/subscribe/<%= plan.id %>"
            onsubmit="return confirm('确认订阅 <%= plan.name %>？')">
            <button type="submit" class="mi-btn mi-btn-primary">订阅</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</body>
</html>
