<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>兑换码 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-container-sm mi-page" style="padding-top: 64px;">
    <h1 class="mi-page-title mi-text-center">兑换码</h1>
    <form method="POST" class="mi-form-card">
      <div class="mi-input-group">
        <label class="mi-label">输入兑换码</label>
        <input type="text" name="code" required placeholder="XXXX-XXXX-XXXX"
          class="mi-input mi-text-center" style="font-family: 'SF Mono', 'Fira Code', monospace; letter-spacing: 2px; font-size: 18px;">
      </div>
      <button type="submit" class="mi-btn mi-btn-primary mi-btn-block mi-mt-2">兑换</button>
    </form>
  </div>
</body>
</html>
