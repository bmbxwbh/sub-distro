<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>兑换码 - sub-distro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>

  <div class="max-w-md mx-auto mt-20 px-4">
    <h1 class="text-2xl font-bold mb-6 text-center">兑换码</h1>
    <form method="POST" class="bg-white p-6 rounded-lg shadow space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">输入兑换码</label>
        <input type="text" name="code" required placeholder="XXXX-XXXX-XXXX"
          class="w-full border rounded-lg px-3 py-2 text-center text-lg font-mono tracking-wider
          focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">兑换</button>
    </form>
  </div>
</body>
</html>
