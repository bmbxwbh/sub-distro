<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>我的订单 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-page">
    <h1 class="mi-page-title">我的订单</h1>

    <% if (orders.length === 0) { %>
    <div class="mi-card">
      <div class="mi-empty">
        <div class="mi-empty-icon">🧾</div>
        <p class="mi-empty-text">暂无订单</p>
        <a href="/user/plans" class="mi-btn mi-btn-primary">浏览套餐</a>
      </div>
    </div>
    <% } else { %>
    <div class="mi-table-wrapper">
      <table class="mi-table">
        <thead>
          <tr>
            <th>订单号</th>
            <th>套餐</th>
            <th>原价</th>
            <th>优惠</th>
            <th>实付</th>
            <th>状态</th>
            <th>创建时间</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
          <tr>
            <td data-label="订单号" class="mono"><%= o.order_no %></td>
            <td data-label="套餐"><%= o.plan_name || '-' %></td>
            <td data-label="原价">¥<%= o.amount.toFixed(2) %></td>
            <td data-label="优惠">
              <% if (o.discount > 0) { %>
                <span class="mi-text-error">-¥<%= o.discount.toFixed(2) %></span>
                <% if (o.coupon_code) { %><br><span class="mi-text-xs mi-text-muted"><%= o.coupon_code %></span><% } %>
              <% } else { %>
                <span class="mi-text-muted">-</span>
              <% } %>
            </td>
            <td data-label="实付"><strong>¥<%= o.final_amount.toFixed(2) %></strong></td>
            <td data-label="状态">
              <span class="mi-badge <%= o.status === 'paid' ? 'mi-badge-success' : o.status === 'pending' ? 'mi-badge-warning' : 'mi-badge-error' %>">
                <%= o.status === 'paid' ? '已支付' : o.status === 'pending' ? '待支付' : o.status === 'failed' ? '失败' : '已退款' %>
              </span>
            </td>
            <td data-label="时间" class="mi-text-sm mi-text-muted"><%= o.created_at %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="mi-flex mi-gap-3 mi-mt-6">
      <a href="/user" class="mi-btn mi-btn-secondary">返回用户中心</a>
    </div>
  </div>
</body>
</html>
