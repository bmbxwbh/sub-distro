<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 - sub-distro</title>
  <link rel="stylesheet" href="/css/miuix.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="mi-container mi-container-sm mi-page" style="padding-top: 32px;">
    <h1 class="mi-page-title mi-text-center">注册</h1>
    <form method="POST" class="mi-form-card">
      <div class="mi-input-group">
        <label class="mi-label">用户名</label>
        <input type="text" name="username" required class="mi-input" placeholder="请输入用户名" autocomplete="username">
      </div>
      <div class="mi-input-group">
        <label class="mi-label">邮箱（可选）</label>
        <input type="email" name="email" class="mi-input" placeholder="your@email.com" autocomplete="email">
      </div>
      <div class="mi-input-group">
        <label class="mi-label">密码</label>
        <input type="password" name="password" required minlength="6" class="mi-input" placeholder="至少 6 位" autocomplete="new-password">
      </div>
      <button type="submit" class="mi-btn mi-btn-primary mi-btn-block mi-mt-2">注册</button>
      <p class="mi-text-center mi-text-sm mi-text-muted mi-mt-4">
        已有账号？<a href="/auth/login">登录</a>
      </p>
    </form>
  </div>
</body>
</html>
